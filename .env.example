# Copy to .env (git-ignored) and adjust. In Docker the same variables are set
# by docker-compose.yaml with service names instead of localhost.
POSTGRES_DSN=host=localhost user=myuser password=mypassword dbname=mydb port=5432 sslmode=disable search_path=payment-service
KAFKA_BROKERS=localhost:9092
KAFKA_PRODUCER_TOPIC=payment-service
KAFKA_CONSUMER_TOPICS=order-service
KAFKA_GROUP_ID=payment-service
PORT=8083
LOGLEVEL=info
ALLOWED_ORIGINS=*
# Mock gateway from payment-gateway/ (port 8082).
PAYMENT_GATEWAY_URL=http://localhost:8082/v1/charges
# Callback URL the gateway will POST to; must be reachable from the gateway.
PAYMENT_WEBHOOK_URL=http://localhost:8083/v1/payments/webhook
# Shared HMAC-SHA256 secret; must match WEBHOOK_SECRET of payment-gateway.
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
